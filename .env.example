# ---------------------------------------------------------------------------
# Bazaarvoice loader (required)
#
# These build the bv.js URL:
#   https://apps.bazaarvoice.com/deployments/<client>/<site>/<environment>/<locale>/bv.js
# ---------------------------------------------------------------------------

# Your Bazaarvoice client name, lowercase. From your Bazaarvoice implementation
# team or the deployment URL of an existing bv.js tag on your storefront.
BV_CLIENT_NAME=

# Deployment zone ID. Bazaarvoice's default zone is `main_site`. Confirm it in
# the Bazaarvoice portal: Site Manager -> the icon to the right of the zone.
BV_SITE_ID=main_site

# `staging` or `production`. Leave unset on Vercel: Production deployments
# resolve to `production` and everything else to `staging`. Set it explicitly
# only when a deployment's Bazaarvoice environment differs from that default.
# BV_ENVIRONMENT=

# Bazaarvoice locale code, e.g. en_US, en_CA, fr_CA.
BV_LOCALE=en_US

# Set to true only if the Bazaarvoice cookie-consent (OneTrust) integration is
# enabled for your account. Adds cdn.cookielaw.org to the CSP.
BV_COOKIE_CONSENT=false


# ---------------------------------------------------------------------------
# Form behaviour
# ---------------------------------------------------------------------------

# What the mpsClose handler does when the consumer closes the form.
#   completed - redirect only when every product was reviewed (default)
#   always    - redirect on every close
#   never     - fire the local `bootz:mpsClose` event but do not navigate
MPS_REDIRECT_ON_CLOSE=completed

# Same-origin path only. Absolute and protocol-relative URLs are rejected.
MPS_THANK_YOU_PATH=/thank-you


# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------

BRAND_NAME=Bootz

# Absolute URL to the header logo. Whatever host serves it must also be listed
# in CSP_EXTRA_IMG_SRC below, or put the file in public/ and use a `/` path.
# BRAND_LOGO_URL=

# Where the header and footer links point.
# BRAND_HOME_URL=https://www.example.com


# ---------------------------------------------------------------------------
# Content Security Policy
#
# Defaults follow Bazaarvoice's CSP reference for V2 applications. See the
# README ("Content Security Policy") before changing these.
# ---------------------------------------------------------------------------

# enforce (default) | report-only | off
# Use `off` if a CDN or edge layer in front of this app already sets a CSP:
# two CSP headers intersect, and the intersection will break the form.
CSP_MODE=enforce

# Space- or comma-separated extra sources, appended to the defaults. Use these
# for tag managers, analytics, or an externally hosted brand logo.
# CSP_EXTRA_SCRIPT_SRC=
# CSP_EXTRA_STYLE_SRC=
# CSP_EXTRA_IMG_SRC=
# CSP_EXTRA_CONNECT_SRC=
# CSP_EXTRA_FRAME_SRC=
